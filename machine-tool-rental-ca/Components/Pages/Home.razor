@page "/"
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>東和機工レンタル | 工作機械を必要な期間だけ</PageTitle>

<section class="hero">
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <h1>買わずに、使う。<br>工作機械を必要な期間だけ。</h1>
      <p>旋盤、フライス盤、マシニングセンタまで。試作や短納期の案件、設備の入れ替え期間に、整備済みの機械を最短1週間からお貸しします。</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#machines">機械を探す</a>
        <a class="btn btn-ghost" href="#contact">相談する</a>
      </div>
    </div>

    <aside class="plate" aria-label="サービス概要">
      <p class="plate-title">RENTAL SPEC</p>
      <dl>
        <div><dt>取扱機種</dt><dd>旋盤 / フライス盤 / MC / 研削盤 / 溶接機</dd></div>
        <div><dt>貸出期間</dt><dd>1週間〜（長期割引あり）</dd></div>
        <div><dt>搬入設置</dt><dd>関東一円 立会い設置</dd></div>
        <div><dt>整備</dt><dd>貸出前に精度検査・点検済み</dd></div>
        <div><dt>保守</dt><dd>故障時は代替機を手配</dd></div>
      </dl>
    </aside>
  </div>
</section>

<section class="section" id="machines">
  <div class="wrap">
    <div class="section-head">
      <h2>レンタル機械一覧</h2>
      <p>空き状況は毎日更新しています。</p>
    </div>

    <ul class="filter" aria-label="カテゴリで絞り込み">
      <li><a class="@(string.IsNullOrEmpty(Category) ? "is-current" : null)" href="/#machines">すべて</a></li>
      @foreach (var c in categories)
      {
        <li><a class="@(c == Category ? "is-current" : null)" href="@CategoryUrl(c)">@c</a></li>
      }
    </ul>

    @if (machines is null)
    {
      <p>読み込み中…</p>
    }
    else if (machines.Count == 0)
    {
      <p>該当する機械はありません。</p>
    }
    else
    {
      <div class="machine-grid">
        @foreach (var m in machines)
        {
          <article class="machine">
            <a class="machine-link" href="/machines/@m.Id">
              <div class="machine-photo">
                <span class="status @m.Status.CssClass()">@m.Status.Label()</span>
                @if (!string.IsNullOrWhiteSpace(m.ImageUrl))
                {
                  <img src="@m.ImageUrl" alt="@m.Name" />
                }
                else
                {
                  <span class="ph">機械写真</span>
                }
              </div>
              <div class="machine-body">
                <p class="machine-cat">@m.Category</p>
                <h3>@m.Name</h3>
                <p class="machine-maker">@m.MakerLine()</p>
                @if (m.Specs.Count > 0)
                {
                  <dl class="spec">
                    @foreach (var s in m.Specs.OrderBy(x => x.SortOrder).Take(3))
                    {
                      <div><dt>@s.Name</dt><dd>@s.Value</dd></div>
                    }
                  </dl>
                }
                <p class="price"><small>月額</small>@($"¥{m.MonthlyPrice:N0}")<small>〜</small></p>
              </div>
            </a>
          </article>
        }
      </div>

      @if (totalPages > 1)
      {
        <nav class="pager" aria-label="ページ送り">
          @for (var p = 1; p <= totalPages; p++)
          {
            var n = p;
            <a class="@(n == currentPage ? "is-current" : null)" href="@PageUrl(n)">@n</a>
          }
          @if (currentPage < totalPages)
          {
            <a href="@PageUrl(currentPage + 1)">次へ</a>
          }
        </nav>
      }
    }
  </div>
</section>

<section class="section section-tint" id="strengths">
  <div class="wrap">
    <div class="section-head"><h2>選ばれる理由</h2></div>
    <div class="strengths">
      <div>
        <h3>1週間から借りられる</h3>
        <p>試作や納期が重なった時期だけ。設備投資を抱えずに受注できます。</p>
      </div>
      <div>
        <h3>貸出前に精度を検査</h3>
        <p>全機種、貸出のたびに精度検査と消耗部品の交換を行います。</p>
      </div>
      <div>
        <h3>搬入から設置まで一括</h3>
        <p>専任スタッフが立ち会い、水平出しと試運転までご対応します。</p>
      </div>
    </div>
  </div>
</section>

<section class="section" id="flow">
  <div class="wrap">
    <div class="section-head"><h2>ご利用の流れ</h2></div>
    <ol class="flow">
      <li><h3>機械を選ぶ</h3><p>一覧から希望の機械と期間を確認します。</p></li>
      <li><h3>見積もり依頼</h3><p>フォームか電話で連絡。1営業日以内に回答します。</p></li>
      <li><h3>契約・搬入</h3><p>契約後、日程を調整して搬入・設置します。</p></li>
      <li><h3>返却</h3><p>期間終了後に引き取りに伺います。</p></li>
    </ol>
  </div>
</section>

<section class="section section-tint" id="faq">
  <div class="wrap narrow">
    <div class="section-head"><h2>よくある質問</h2></div>
    <details>
      <summary>最短の貸出期間はどれくらいですか？</summary>
      <p>1週間からご利用いただけます。機種により最短期間が異なる場合があります。</p>
    </details>
    <details>
      <summary>工具や治具も借りられますか？</summary>
      <p>バイトやエンドミルなど基本工具のセット貸しが可能です。見積もり時にご相談ください。</p>
    </details>
    <details>
      <summary>配送エリアを教えてください。</summary>
      <p>関東一円に対応しています。それ以外の地域もお問い合わせください。</p>
    </details>
    <details>
      <summary>操作や段取りの講習はありますか？</summary>
      <p>初回設置時に操作説明を行います。有償で技術者の派遣も承ります。</p>
    </details>
  </div>
</section>

<section class="contact" id="contact">
  <div class="wrap contact-inner">
    <div>
      <h2>機械の空き状況・料金のご相談</h2>
      <p>お探しの加工内容と希望期間をお知らせください。最適な機械をご提案します。</p>
    </div>
    <div class="contact-actions">
      <a class="btn btn-light" href="#">見積もりフォームへ</a>
      <a class="contact-tel" href="tel:0312345678">03-1234-5678</a>
    </div>
  </div>
</section>

@code {
    private const int PageSize = 6;

    [SupplyParameterFromQuery(Name = "category")] public string? Category { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int Page { get; set; }

    private List<string> categories = [];
    private List<RentalMachine>? machines;
    private int totalPages = 1;
    private int currentPage = 1;

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        // カテゴリは登録順（最初に登場した順）で並べる
        categories = await db.RentalMachines.AsNoTracking()
            .GroupBy(m => m.Category)
            .OrderBy(g => g.Min(m => m.Id))
            .Select(g => g.Key)
            .ToListAsync();

        IQueryable<RentalMachine> query = db.RentalMachines.AsNoTracking();
        if (!string.IsNullOrWhiteSpace(Category))
        {
            query = query.Where(m => m.Category == Category);
        }

        var total = await query.CountAsync();
        totalPages = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
        currentPage = Math.Clamp(Page, 1, totalPages);

        // 一覧カードには仕様の先頭3行だけ表示する
        machines = await query
            .Include(m => m.Specs.OrderBy(s => s.SortOrder).Take(3))
            .OrderBy(m => m.Id)
            .Skip((currentPage - 1) * PageSize)
            .Take(PageSize)
            .ToListAsync();
    }

    private string CategoryUrl(string category) =>
        $"/?category={Uri.EscapeDataString(category)}#machines";

    private string PageUrl(int page)
    {
        var query = string.IsNullOrWhiteSpace(Category)
            ? $"page={page}"
            : $"category={Uri.EscapeDataString(Category)}&page={page}";
        return $"/?{query}#machines";
    }
}
