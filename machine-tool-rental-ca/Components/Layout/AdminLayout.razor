@inherits LayoutComponentBase
@inject NavigationManager Nav

<header class="site-header admin">
    <div class="wrap header-inner">
        <a class="logo" href="/admin/machines">東和機工<span>管理画面</span></a>
        <nav class="gnav" aria-label="管理メニュー">
            <a href="/admin/machines">レンタル機械</a>
            <a href="/">公開サイトを見る</a>
        </nav>
        <div class="header-cta">
            <AuthorizeView>
                <Authorized>
                    <span class="admin-user">@context.User.Identity?.Name</span>
                    <button type="button" class="btn btn-ghost" @onclick="Logout">ログアウト</button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</header>

<main class="wrap admin-main">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private void Logout() => Nav.NavigateTo("/auth/logout", forceLoad: true);
}
